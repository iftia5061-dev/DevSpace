rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authorized Admin UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'nXUfSk9iMVVoctVAeMBE7ys4XC13';
    }
    
    // Profile - Public read, Admin write
    match /profile/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Skills - Public read published, Admin write
    match /skills/{document} {
      allow read: if resource.data.visible == true;
      allow write: if isAdmin();
    }
    
    // Projects - Public read published, Admin write
    match /projects/{document} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }
    
    // Services - Public read visible, Admin write
    match /services/{document} {
      allow read: if resource.data.visible == true;
      allow write: if isAdmin();
    }
    
    // Experience - Public read, Admin write
    match /experience/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Certificates - Public read, Admin write
    match /certificates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Messages - Admin only
    match /messages/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Settings - Admin only
    match /settings/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Activity Logs - Admin only
    match /activityLogs/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Deny all other requests
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
